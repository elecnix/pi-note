{
  "name": "pi-note",
  "version": "0.1.0",
  "description": "Pi extension adding /note (visible to the model next turn) and /private-note (never visible to the model). Neither triggers an agent turn.",
  "keywords": ["pi-package", "pi-extension", "note", "scratchpad", "notes"],
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "./src/index.ts",
    "./README.md",
    "./LICENSE"
  ],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}